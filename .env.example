# ------------------------------------------------------------------
# Jersey Museum - environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ------------------------------------------------------------------

APP_NAME="Jersey Museum"
APP_ENV=production            # local | staging | production
APP_DEBUG=false               # true only on local machines
APP_URL=https://www.jerseymuseum.com
APP_TIMEZONE=Asia/Kolkata
# 64 random hex chars. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ---- Database (MySQL 8 / MariaDB 10.6+) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jersey_musium
DB_USERNAME=jersey_user
DB_PASSWORD=

# ---- Session ----
SESSION_NAME=jm_session
SESSION_LIFETIME=120          # minutes
SESSION_SECURE=true           # requires HTTPS (keep true in production)

# ---- Razorpay (https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cashfree PG (https://merchant.cashfree.com) ----
CASHFREE_ENV=sandbox          # sandbox | production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# ---- Mail (SMTP) ----
MAIL_DRIVER=log               # log | smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls           # tls | ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@jerseymuseum.com
MAIL_FROM_NAME="Jersey Museum"

# ---- Uploads ----
UPLOAD_MAX_MB=5

# ---- Outbound HTTPS (payment gateways) ----
# Only needed if PHP's cURL has no CA certificate bundle (e.g. some Windows/dev PHP builds).
# Download https://curl.se/ca/cacert.pem and point to it. NEVER disable SSL verification instead.
HTTP_CA_BUNDLE=

# ---- Security ----
ADMIN_2FA=true                # email a 6-digit code after admin password
TRUST_CLOUDFLARE=false        # true ONLY if traffic always comes through Cloudflare

# ---- One-time web setup (only for hosts without SSH) ----
# Set a long random value (≥ 24 chars), open https://yourdomain/setup?token=THAT_VALUE once to create
# the first Super Admin, then delete this line. The page is disabled as soon as an admin exists.
SETUP_TOKEN=
